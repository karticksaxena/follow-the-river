{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "shell",
      "command": "pnpm run dev",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "pnpm run --silent lint --format unix",
      "problemMatcher": [
        {
          "owner": "oxlint",
          "source": "oxlint",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+): (.*) \\[(Error|Warning)/(.+)\\]$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4,
            "severity": 5,
            "code": 6
          }
        }
      ]
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "pnpm run typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "format",
      "type": "shell",
      "command": "pnpm run format:check",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "pnpm run test",
      "problemMatcher": []
    }
  ]
}
